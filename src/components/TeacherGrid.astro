---
import { getEntries, type CollectionEntry } from 'astro:content';
import { url } from '../utils/url';
interface Props {
  title?: string;
  teachers: CollectionEntry<'pages'>['data']['teachers'];
  id?: string;
}
const { title = 'ВИКЛАДАЧІ', teachers, id = 'teachers' } = Astro.props;
const entries = await getEntries(teachers);
const getInfoLines = (info: string) => info.split('·').map((part) => part.trim()).filter(Boolean);
---
<section class="section teachers" id={id}>
  <div class="container">
    <h2 class="teachers__title">{title}</h2>
    <div class="teachers__grid">
      {entries.map((t) => (
        <div class="teacher-card">
          <div class="teacher-card__photo-frame">
            <img
              class="teacher-card__photo"
              src={url(t.data.photo.src)}
              alt={t.data.photo.alt || t.data.name}
              style={[
                t.data.photoScale ? `--teacher-photo-scale:${t.data.photoScale};` : undefined,
                t.data.photoOffsetX ? `--teacher-photo-offset-x:${t.data.photoOffsetX}px;` : undefined,
                t.data.photoOffsetY ? `--teacher-photo-offset-y:${t.data.photoOffsetY}px;` : undefined,
              ]
                .filter(Boolean)
                .join(" ") || undefined}
            />
          </div>
          <h3 class="teacher-card__name">{t.data.name}</h3>
          {t.data.quote && <p class="teacher-card__quote">{t.data.quote}</p>}
          <p class="teacher-card__info">
            {getInfoLines(t.data.info).map((line, index) => (
              <>
                {index > 0 && <br />}
                {line}
              </>
            ))}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
