---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import RateGrid from '../components/RateGrid.astro';
import TeacherGrid from '../components/TeacherGrid.astro';
import ContactSection from '../components/ContactSection.astro';
import ThemedImage from '../components/ThemedImage.astro';

const page = (await getEntry('pages', 'polish'))!.data;
---
<BaseLayout title={page.title}>
  {page.hero && (
    <Hero
      title={page.hero.title}
      subtitle={page.hero.subtitle}
      image={page.hero.image}
      imageMode={page.hero.imageMode}
      overlay={page.hero.overlay}
      ctaLabel={page.hero.ctaLabel}
      ctaHref={page.hero.ctaHref}
    />
  )}

  {page.about && (
    <section class="section about" id="offer">
      <div class="container">
        <div class="about__inner">
          <div class="about__content">
            {page.about.label && <p class="about__label">{page.about.label}</p>}
            <h2 class="about__title">{page.about.title}</h2>
            {page.about.bullets.length > 0 && (
              <ul class="about__bullets">
                {page.about.bullets.map((b) => (
                  <li><span class="about__tick">✓</span><span>{b}</span></li>
                ))}
              </ul>
            )}
            {page.about.paragraphs.map((p) => (
              <p class="about__text">{p.split(/(<strong>[\s\S]*?<\/strong>)/g).map((part) =>
                part.startsWith('<strong>') && part.endsWith('</strong>')
                  ? <strong>{part.slice(8, -9)}</strong>
                  : part
              )}</p>
            ))}
          </div>
          {page.about.image && (
            <div class="about__image">
              <ThemedImage image={page.about.image} />
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  {page.rates.length > 0 && <RateGrid title={page.ratesTitle} rates={page.rates} />}

  {page.teachers.length > 0 && (
    <TeacherGrid title={page.teachersTitle} teachers={page.teachers} />
  )}

  {page.contact && (
    <ContactSection
      title={page.contact.title}
      text={page.contact.text}
      formTitle={page.contact.formTitle}
      formIdPrefix="pl"
      showInstagram={false}
      showEmail
    />
  )}
</BaseLayout>
